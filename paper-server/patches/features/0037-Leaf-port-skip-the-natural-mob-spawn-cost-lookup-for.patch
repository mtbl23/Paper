+    // Leaf port start - see EnvironmentAttributeSystem#mayHaveNaturalMobSpawnCost
+    private static MobSpawnSettings.@Nullable MobSpawnCost getNaturalMobSpawnCost(final Level level, final BlockPos pos, final EntityType<?> type) {
+        net.minecraft.world.attribute.EnvironmentAttributeSystem attributes = level.environmentAttributes();
+        if (!attributes.mayHaveNaturalMobSpawnCost(type)) {
+            return null;
+        }
+
+        return attributes.getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos).getMobSpawnCost(type);
+    }
