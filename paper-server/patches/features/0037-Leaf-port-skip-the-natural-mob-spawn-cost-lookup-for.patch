 public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
     private final Map<EnvironmentAttribute<?>, EnvironmentAttributeSystem.ValueSampler<?>> attributeSamplers = new Reference2ObjectOpenHashMap<>();
+    // Leaf port start - skip the NATURAL_MOB_SPAWNS lookup for entity types that no biome gives a spawn cost (null = unknown, always look up)
+    private final @Nullable Set<EntityType<?>> naturalMobSpawnCostTypes;
+    // Leaf port end
 
-    private EnvironmentAttributeSystem(final Map<EnvironmentAttribute<?>, List<EnvironmentAttributeLayer<?>>> layersByAttribute) {
+    private EnvironmentAttributeSystem(
+        final Map<EnvironmentAttribute<?>, List<EnvironmentAttributeLayer<?>>> layersByAttribute, final @Nullable Set<EntityType<?>> biomeSpawnCostTypes
+    ) {
         layersByAttribute.forEach(
             (attribute, layers) -> this.attributeSamplers
                 .put(
@@ -36,8 +45,34 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
                     this.bakeLayerSampler((EnvironmentAttribute<?>)attribute, (List<? extends EnvironmentAttributeLayer<?>>)layers)
                 )
         );
+        this.naturalMobSpawnCostTypes = this.computeNaturalMobSpawnCostTypes(biomeSpawnCostTypes); // Leaf port
+    }
+
+    // Leaf port start - Inspired by Leaf's async/optimised mob counting (createState); independent, vanilla-identical implementation.
+    // A mob spawn cost can only come from the constant base value or from a biome's NATURAL_MOB_SPAWNS entry (overlay and override
+    // both only ever produce a subset of the union of their inputs' costs), so any type outside that union always yields a null cost.
+    private @Nullable Set<EntityType<?>> computeNaturalMobSpawnCostTypes(final @Nullable Set<EntityType<?>> biomeSpawnCostTypes) {
+        EnvironmentAttributeSystem.ValueSampler<?> sampler = this.attributeSamplers.get(EnvironmentAttributes.NATURAL_MOB_SPAWNS);
+        MobSpawnSettings base = sampler == null ? EnvironmentAttributes.NATURAL_MOB_SPAWNS.defaultValue() : (MobSpawnSettings)sampler.baseValue;
+        Set<EntityType<?>> types = new ReferenceOpenHashSet<>(base.allSpawnCosts().keySet());
+        if (sampler == null || sampler.layers.isEmpty()) {
+            return types;
+        }
+
+        if (biomeSpawnCostTypes != null && sampler.layers.size() == 1 && sampler.layers.getFirst() instanceof EnvironmentAttributeLayer.Positional) {
+            types.addAll(biomeSpawnCostTypes);
+            return types;
+        }
+
+        return null;
     }
 
+    public boolean mayHaveNaturalMobSpawnCost(final EntityType<?> type) {
+        Set<EntityType<?>> types = this.naturalMobSpawnCostTypes;
+        return types == null || types.contains(type);
+    }
+    // Leaf port end
+
     private <Value> EnvironmentAttributeSystem.ValueSampler<Value> bakeLayerSampler(
         final EnvironmentAttribute<Value> attribute, final List<? extends EnvironmentAttributeLayer<?>> untypedLayers
     ) {
@@ -66,7 +101,26 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
         BiomeManager biomeManager = level.getBiomeManager();
         addDimensionLayer(builder, level.dimensionType());
         addBiomeLayer(builder, registries.lookupOrThrow(Registries.BIOME), biomeManager);
+        builder.biomeSpawnCostTypes = collectBiomeSpawnCostTypes(registries.lookupOrThrow(Registries.BIOME)); // Leaf port
+    }
+
+    // Leaf port start
+    private static @Nullable Set<EntityType<?>> collectBiomeSpawnCostTypes(final HolderLookup<Biome> biomes) {
+        Set<EntityType<?>> types = new ReferenceOpenHashSet<>();
+        boolean[] known = {true};
+        biomes.listElements().forEach(biome -> {
+            EnvironmentAttributeMap.Entry<MobSpawnSettings, ?> entry = biome.value().getAttributes().get(EnvironmentAttributes.NATURAL_MOB_SPAWNS);
+            if (entry != null) {
+                if (entry.argument() instanceof MobSpawnSettings settings) {
+                    types.addAll(settings.allSpawnCosts().keySet());
+                } else {
+                    known[0] = false;
+                }
+            }
+        });
+        return known[0] ? types : null;
     }
+    // Leaf port end
 
     private static void addDynamicLayers(final EnvironmentAttributeSystem.Builder builder, final Level level) {
         ClockManager clockManager = level.clockManager();
@@ -143,6 +197,7 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
 
     public static class Builder {
         private final Map<EnvironmentAttribute<?>, List<EnvironmentAttributeLayer<?>>> layersByAttribute = new HashMap<>();
+        private @Nullable Set<EntityType<?>> biomeSpawnCostTypes; // Leaf port
 
         private Builder() {
         }
@@ -220,7 +275,7 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
         }
 
         public EnvironmentAttributeSystem build() {
-            return new EnvironmentAttributeSystem(this.layersByAttribute);
+            return new EnvironmentAttributeSystem(this.layersByAttribute, this.biomeSpawnCostTypes);
         }
     }
 
