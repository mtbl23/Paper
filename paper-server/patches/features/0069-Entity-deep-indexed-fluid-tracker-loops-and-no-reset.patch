From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mtbl23 <mbhangal23@gmail.com>
Date: Fri, 13 Nov 2026 00:20:56 -0500
Subject: [PATCH] Entity deep: indexed fluid tracker loops and no reset work
 for entities outside fluids

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/net/minecraft/world/entity/EntityFluidInteraction.java b/net/minecraft/world/entity/EntityFluidInteraction.java
index ed6aa849a7ba718f673026c74a454f993f791ee5..3484f4dc8ce92ea8cef8e302b73a1a304b90bf28 100644
--- a/net/minecraft/world/entity/EntityFluidInteraction.java
+++ b/net/minecraft/world/entity/EntityFluidInteraction.java
@@ -35,8 +35,14 @@ public class EntityFluidInteraction {
     }
 
     public boolean update(final Entity entity, final boolean ignoreCurrent) {
-        this.fluidTrackers.removeIf(EntityFluidInteraction.Tracker::reset);
-        this.currentAccumulators.values().forEach(EntityFluidInteraction.CurrentAccumulator::reset);
+        // entity deep: nothing to reset for the usual entity that is not in any fluid
+        if (!this.fluidTrackers.isEmpty()) {
+            this.fluidTrackers.removeIf(EntityFluidInteraction.Tracker::reset);
+        }
+
+        if (!this.currentAccumulators.isEmpty()) {
+            this.currentAccumulators.values().forEach(EntityFluidInteraction.CurrentAccumulator::reset);
+        }
         AABB box = entity.getFluidInteractionBox();
         if (box == null) {
             return false;
@@ -142,7 +148,8 @@ public class EntityFluidInteraction {
     }
 
     private EntityFluidInteraction.Tracker getOrCreateTrackerFor(final Holder<Fluid> fluidType) {
-        for (EntityFluidInteraction.Tracker tracker : this.fluidTrackers) {
+        for (int i = 0, size = this.fluidTrackers.size(); i < size; i++) { // entity deep: indexed, no iterator
+            final EntityFluidInteraction.Tracker tracker = this.fluidTrackers.get(i);
             if (tracker.fluidType.equals(fluidType)) {
                 return tracker;
             }
@@ -173,7 +180,8 @@ public class EntityFluidInteraction {
     public double getFluidHeight(final TagKey<Fluid> fluid) {
         double height = 0.0;
 
-        for (EntityFluidInteraction.Tracker tracker : this.fluidTrackers) {
+        for (int i = 0, size = this.fluidTrackers.size(); i < size; i++) { // entity deep: indexed, no iterator
+            final EntityFluidInteraction.Tracker tracker = this.fluidTrackers.get(i);
             if (tracker.height > height && tracker.fluidType.is(fluid)) {
                 height = tracker.height;
             }
@@ -187,7 +195,8 @@ public class EntityFluidInteraction {
     }
 
     public boolean isEyeInFluid(final TagKey<Fluid> fluid) {
-        for (EntityFluidInteraction.Tracker tracker : this.fluidTrackers) {
+        for (int i = 0, size = this.fluidTrackers.size(); i < size; i++) { // entity deep: indexed, no iterator
+            final EntityFluidInteraction.Tracker tracker = this.fluidTrackers.get(i);
             if (tracker.eyesInside && tracker.fluidType.is(fluid)) {
                 return true;
             }
