From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mtbl23 <mtbl23@users.noreply.github.com>
Date: Tue, 10 Nov 2026 16:34:14 -0500
Subject: [PATCH] Leaf port: array based inside-block effect collector

InsideBlockEffectApplier.StepBasedCollector kept its per-step effects in
EnumMaps and, for every visited block step of Entity#checkInsideBlocks, walked
all effect types with three map operations each (advanceStep -> flushStep was
about a fifth of the checkInsideBlocks callback in the 12 bot profile). The
effects now live in arrays indexed by the effect type ordinal and empty lists
are not touched.

Behaviour: identical order of effects.

Ported from Leaf "optimize checkInsideBlocks calls" by Taiyou06 <kaandindar21@gmail.com>
(License: LGPL-3.0-only).
Leaf: https://github.com/Winds-Studio/Leaf

diff --git a/net/minecraft/world/entity/InsideBlockEffectApplier.java b/net/minecraft/world/entity/InsideBlockEffectApplier.java
index c2f124383be06ae777c1ee7f0820c959c8359f87..eb63158301b042613b4c8299b46ba00dc35aea42 100644
--- a/net/minecraft/world/entity/InsideBlockEffectApplier.java
+++ b/net/minecraft/world/entity/InsideBlockEffectApplier.java
@@ -32,16 +32,22 @@ public interface InsideBlockEffectApplier {
     class StepBasedCollector implements InsideBlockEffectApplier {
         private static final InsideBlockEffectType[] APPLY_ORDER = InsideBlockEffectType.values();
         private static final int NO_STEP = -1;
-        private final Map<InsideBlockEffectType, Consumer<Entity>> effectsInStep = new java.util.EnumMap<>(InsideBlockEffectType.class); // Paper - track position inside effect was triggered on
-        private final Map<InsideBlockEffectType, List<Consumer<Entity>>> beforeEffectsInStep = Util.makeEnumMap(
-            InsideBlockEffectType.class, type -> new ArrayList<>()
-        );
-        private final Map<InsideBlockEffectType, List<Consumer<Entity>>> afterEffectsInStep = Util.makeEnumMap(
-            InsideBlockEffectType.class, type -> new ArrayList<>()
-        );
+        // Leaf port start - ordinal indexed arrays instead of the EnumMaps; same order of effects (Leaf "optimize checkInsideBlocks calls", Taiyou06; LGPL-3.0-only)
+        private final Consumer<Entity>[] effectsInStep = new Consumer[APPLY_ORDER.length]; // Paper - track position inside effect was triggered on
+        private final List<Consumer<Entity>>[] beforeEffectsInStep = createEffectLists();
+        private final List<Consumer<Entity>>[] afterEffectsInStep = createEffectLists();
         private final List<Consumer<Entity>> finalEffects = new ArrayList<>();
         private int lastStep = -1;
 
+        private static List<Consumer<Entity>>[] createEffectLists() {
+            final List<Consumer<Entity>>[] lists = new List[APPLY_ORDER.length];
+            for (int i = 0; i < lists.length; i++) {
+                lists[i] = new ArrayList<>(2);
+            }
+
+            return lists;
+        }
+
         public void advanceStep(final int step, net.minecraft.core.BlockPos pos) { // Paper - track position inside effect was triggered on
             this.currentBlockPos = pos; // Paper - track position inside effect was triggered on
             if (this.lastStep != step) {
@@ -66,34 +72,42 @@ public interface InsideBlockEffectApplier {
         }
 
         private void flushStep() {
-            for (InsideBlockEffectType type : APPLY_ORDER) {
-                List<Consumer<Entity>> beforeEffects = this.beforeEffectsInStep.get(type);
-                this.finalEffects.addAll(beforeEffects);
-                beforeEffects.clear();
-                if (this.effectsInStep.remove(type) instanceof final Consumer<Entity> recordedEffect) { // Paper - track position inside effect was triggered on - better than null check to avoid diff.
+            for (int i = 0; i < APPLY_ORDER.length; i++) {
+                List<Consumer<Entity>> beforeEffects = this.beforeEffectsInStep[i];
+                if (!beforeEffects.isEmpty()) {
+                    this.finalEffects.addAll(beforeEffects);
+                    beforeEffects.clear();
+                }
+
+                Consumer<Entity> recordedEffect = this.effectsInStep[i];
+                if (recordedEffect != null) {
+                    this.effectsInStep[i] = null;
                     this.finalEffects.add(recordedEffect); // Paper - track position inside effect was triggered on
                 }
 
-                List<Consumer<Entity>> afterEffects = this.afterEffectsInStep.get(type);
-                this.finalEffects.addAll(afterEffects);
-                afterEffects.clear();
+                List<Consumer<Entity>> afterEffects = this.afterEffectsInStep[i];
+                if (!afterEffects.isEmpty()) {
+                    this.finalEffects.addAll(afterEffects);
+                    afterEffects.clear();
+                }
             }
         }
 
         @Override
         public void apply(final InsideBlockEffectType type) {
-            this.effectsInStep.put(type, recorded(type)); // Paper - track position inside effect was triggered on
+            this.effectsInStep[type.ordinal()] = recorded(type); // Paper - track position inside effect was triggered on
         }
 
         @Override
         public void runBefore(final InsideBlockEffectType type, final Consumer<Entity> effect) {
-            this.beforeEffectsInStep.get(type).add(effect);
+            this.beforeEffectsInStep[type.ordinal()].add(effect);
         }
 
         @Override
         public void runAfter(final InsideBlockEffectType type, final Consumer<Entity> effect) {
-            this.afterEffectsInStep.get(type).add(effect);
+            this.afterEffectsInStep[type.ordinal()].add(effect);
         }
+        // Leaf port end
 
         // Paper start - track position inside effect was triggered on
         private net.minecraft.core.@org.jspecify.annotations.Nullable BlockPos currentBlockPos = null;
