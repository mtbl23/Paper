From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mtbl23 <mbhangal23@gmail.com>
Date: Thu, 12 Nov 2026 23:56:49 -0500
Subject: [PATCH] Lab only: in-process players, packet and entity state
 hashing, determinism hooks (-Dlab.net, -Dlab.det)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/net/minecraft/server/LabNet.java b/net/minecraft/server/LabNet.java
new file mode 100644
index 0000000000000000000000000000000000000000..696c86621283a774b883d6e24687b4b873018185
--- /dev/null
+++ b/net/minecraft/server/LabNet.java
@@ -0,0 +1,321 @@
+package net.minecraft.server;
+
+import com.mojang.authlib.GameProfile;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import java.io.BufferedWriter;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import net.minecraft.core.BlockPos;
+import net.minecraft.network.Connection;
+import net.minecraft.network.ProtocolInfo;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.protocol.BundlePacket;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.PacketFlow;
+import net.minecraft.network.protocol.common.ClientboundKeepAlivePacket;
+import net.minecraft.network.protocol.common.ServerboundKeepAlivePacket;
+import net.minecraft.network.protocol.game.ClientGamePacketListener;
+import net.minecraft.network.protocol.game.ClientboundPlayerPositionPacket;
+import net.minecraft.network.protocol.game.ClientboundChunkBatchFinishedPacket;
+import net.minecraft.network.protocol.game.GameProtocols;
+import net.minecraft.network.protocol.game.ServerboundAcceptTeleportationPacket;
+import net.minecraft.network.protocol.game.ServerboundChunkBatchReceivedPacket;
+import net.minecraft.network.protocol.game.ServerboundMovePlayerPacket;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.network.CommonListenerCookie;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.level.GameType;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.block.Block;
+
+/**
+ * LAB ONLY (differential tests, enabled with -Dlab.net=&lt;output dir&gt;). Drives scripted in-process players over EmbeddedChannel
+ * connections, answers the packets a client must answer, and writes per tick a hash of all entity state and of every packet the
+ * server sent to each player (type, content, order). Two servers that behave identically write identical files.
+ * Properties: lab.net.seed, lab.net.ticks, lab.net.players, lab.net.radius (forced chunk radius), lab.net.detail=from-to (relative ticks),
+ * lab.net.spawn=true to let monsters spawn naturally (night is forced).
+ */
+public final class LabNet {
+    public static final boolean ON = System.getProperty("lab.net") != null;
+    private static final long SEED = Long.getLong("lab.net.seed", 1L);
+    private static final int TICKS = Integer.getInteger("lab.net.ticks", 2000);
+    private static final int PLAYERS = Integer.getInteger("lab.net.players", 6);
+    private static final int RADIUS = Integer.getInteger("lab.net.radius", 14);
+
+    private static int phase; // 0 init, 1 waiting for stable, 2 running, 3 done
+    private static int stableTicks;
+    private static int lastChunks = -1;
+    private static int startTick;
+    private static BufferedWriter out;
+    private static ProtocolInfo<ClientGamePacketListener> info;
+    private static final List<Bot> bots = new ArrayList<>();
+    private static long detailFrom = -1, detailTo = -1;
+
+    private LabNet() {}
+
+    private static final class Bot {
+        final int index;
+        final ServerPlayer player;
+        final EmbeddedChannel channel;
+        final List<Packet<?>> pendingAcks = new ArrayList<>();
+        boolean awaiting;
+        double cx, cz, radius, angle, speed, y;
+
+        Bot(final int index, final ServerPlayer player, final EmbeddedChannel channel) {
+            this.index = index;
+            this.player = player;
+            this.channel = channel;
+        }
+    }
+
+    private static long mix(final long h, final long v) {
+        long x = (h ^ v) * 0x9E3779B97F4A7C15L;
+        return x ^ (x >>> 29);
+    }
+
+    /** At the very start of a tick, before queued work and packets run. */
+    public static void preTick(final MinecraftServer server) {
+        final ServerLevel level = server.overworld();
+        try {
+            if (phase == 0) {
+                init(server, level);
+                phase = 1;
+            } else if (phase == 1) {
+                final int chunks = level.getChunkSource().getLoadedChunksCount();
+                stableTicks = chunks == lastChunks ? stableTicks + 1 : 0;
+                lastChunks = chunks;
+                if (stableTicks >= 100 && level.getGameTime() % 200L == 0L) {
+                    startRun(server, level);
+                    phase = 2;
+                }
+            } else if (phase == 2) {
+                for (final Bot b : bots) {
+                    for (final Packet<?> ack : b.pendingAcks) {
+                        send(b, ack);
+                    }
+                    b.pendingAcks.clear();
+                    b.awaiting = false;
+                    move(b, server.getTickCount() - startTick);
+                }
+            }
+        } catch (final Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static void send(final Bot b, final Packet<?> p) {
+        final var listener = b.player.connection;
+        if (p instanceof ServerboundChunkBatchReceivedPacket c) {
+            listener.handleChunkBatchReceived(c);
+        } else if (p instanceof ServerboundAcceptTeleportationPacket t) {
+            listener.handleAcceptTeleportPacket(t);
+        } else if (p instanceof ServerboundKeepAlivePacket k) {
+            listener.handleKeepAlive(k);
+        }
+    }
+
+    private static void move(final Bot b, final int rel) {
+        if (b.awaiting) {
+            return; // the teleport has not been acknowledged yet
+        }
+        b.angle += b.speed;
+        final double x = b.cx + Math.cos(b.angle) * b.radius;
+        final double z = b.cz + Math.sin(b.angle) * b.radius;
+        final float yaw = (float) Math.toDegrees(b.angle + Math.PI / 2);
+        b.player.connection.handleMovePlayer(new ServerboundMovePlayerPacket.PosRot(x, b.y, z, yaw, 10.0F, false, false));
+    }
+
+    private static void init(final MinecraftServer server, final ServerLevel level) throws Exception {
+        Files.createDirectories(Path.of(System.getProperty("lab.net")));
+        out = Files.newBufferedWriter(Path.of(System.getProperty("lab.net"), "labnet.txt"));
+        final String[] d = System.getProperty("lab.net.detail", "-1:-1").split(":");
+        detailFrom = Long.parseLong(d[0]);
+        detailTo = Long.parseLong(d[1]);
+        info = GameProtocols.CLIENTBOUND_TEMPLATE.bind(RegistryFriendlyByteBuf.decorator(server.registryAccess()));
+        // load and keep the whole test area
+        for (int x = -RADIUS; x <= RADIUS; x++) {
+            for (int z = -RADIUS; z <= RADIUS; z++) {
+                level.setChunkForced(x, z, true);
+                level.getChunkSource().getChunk(x, z, net.minecraft.world.level.chunk.status.ChunkStatus.FULL, true);
+            }
+        }
+    }
+
+    private static void startRun(final MinecraftServer server, final ServerLevel level) throws Exception {
+        // seed everything the simulation draws from
+        level.getRandom().setSeed(SEED * 7919L + 13);
+        Entity.SHARED_RANDOM = new net.minecraft.world.level.levelgen.LegacyRandomSource(SEED * 104729L + 7);
+        final Field ctr = ServerLevel.class.getDeclaredField("ENTITY_COUNTER");
+        ctr.setAccessible(true);
+        ((AtomicInteger) ctr.get(null)).set(100000);
+        final org.bukkit.World world = level.getWorld();
+        world.setFullTime(18000L);
+        world.setGameRule(org.bukkit.GameRules.ADVANCE_TIME, false);
+        world.setGameRule(org.bukkit.GameRules.ADVANCE_WEATHER, false);
+        world.setStorm(false);
+        final java.util.Random rng = new java.util.Random(SEED * 1000003L);
+        for (int i = 0; i < PLAYERS; i++) {
+            final GameProfile profile = new GameProfile(new UUID(0x1234L, 0x5678L + i), "LabBot" + i);
+            final CommonListenerCookie cookie = CommonListenerCookie.createInitial(profile, false);
+            final ServerPlayer p = new ServerPlayer(server, level, profile, cookie.clientInformation());
+            final Connection connection = new Connection(PacketFlow.SERVERBOUND);
+            final EmbeddedChannel ch = new EmbeddedChannel(connection);
+            final Bot b = new Bot(i, p, ch);
+            b.cx = (rng.nextDouble() - 0.5) * 120;
+            b.cz = (rng.nextDouble() - 0.5) * 120;
+            b.radius = 10 + rng.nextDouble() * 40;
+            b.angle = rng.nextDouble() * Math.PI * 2;
+            b.speed = (0.2 + rng.nextDouble() * 0.5) / b.radius * (rng.nextBoolean() ? 1 : -1);
+            b.y = level.getHeight(net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING, (int) b.cx, (int) b.cz) + 2;
+            p.snapTo(b.cx + b.radius, b.y, b.cz, 0.0F, 0.0F);
+            server.getPlayerList().placeNewPlayer(connection, p, cookie);
+            p.setGameMode(GameType.SURVIVAL);
+            p.getAbilities().invulnerable = true;
+            p.getAbilities().mayfly = true;
+            p.getAbilities().flying = true;
+            p.onUpdateAbilities();
+            bots.add(b);
+        }
+        startTick = server.getTickCount();
+    }
+
+    /** At the end of a tick: record. */
+    public static void postTick(final MinecraftServer server) {
+        if (phase != 2) {
+            return;
+        }
+        final int rel = server.getTickCount() - startTick;
+        try {
+            final boolean detail = rel >= detailFrom && rel <= detailTo;
+            long ph = 0;
+            int pc = 0;
+            for (final Bot b : bots) {
+                Object o;
+                while ((o = b.channel.readOutbound()) != null) {
+                    if (o instanceof Packet<?> p) {
+                        final long[] r = record(b, p, rel, detail);
+                        pc += (int) r[0];
+                        ph = mix(ph, r[1]);
+                    }
+                }
+            }
+            final ServerLevel level = server.overworld();
+            final List<Entity> ents = new ArrayList<>();
+            for (final Entity e : level.getAllEntities()) {
+                ents.add(e);
+            }
+            ents.sort((a, c) -> Integer.compare(a.getId(), c.getId()));
+            long eh = 0;
+            for (final Entity e : ents) {
+                long h = mix(e.getId(), e.getType().hashCode() * 31L + e.getType().toString().hashCode());
+                h = mix(h, Double.doubleToLongBits(e.getX()));
+                h = mix(h, Double.doubleToLongBits(e.getY()));
+                h = mix(h, Double.doubleToLongBits(e.getZ()));
+                h = mix(h, Double.doubleToLongBits(e.getDeltaMovement().x));
+                h = mix(h, Double.doubleToLongBits(e.getDeltaMovement().y));
+                h = mix(h, Double.doubleToLongBits(e.getDeltaMovement().z));
+                h = mix(h, Float.floatToIntBits(e.getYRot()) * 31L + Float.floatToIntBits(e.getXRot()));
+                h = mix(h, e.getRemainingFireTicks() * 5L + (e.onGround() ? 1 : 0) + e.tickCount * 7L);
+                if (e instanceof LivingEntity le) {
+                    h = mix(h, Float.floatToIntBits(le.getHealth()));
+                }
+                if (detail) {
+                    out.write("E " + rel + " " + e.getId() + " " + e.getType() + " " + e.getX() + "," + e.getY() + "," + e.getZ() + " " + Long.toHexString(h) + "\n");
+                }
+                eh = mix(eh, h);
+            }
+            out.write("T " + rel + " E " + ents.size() + " " + Long.toHexString(eh) + " P " + pc + " " + Long.toHexString(ph) + "\n");
+            if (rel % 200 == 0) {
+                out.write("B " + rel + " " + Long.toHexString(blockHash(level)) + "\n");
+            }
+            if ((rel & 63) == 0) {
+                out.flush();
+            }
+            if (rel >= TICKS) {
+                out.write("DONE\n");
+                out.close();
+                phase = 3;
+                server.halt(false);
+            }
+        } catch (final Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static long blockHash(final ServerLevel level) {
+        long h = 0;
+        for (int cx = -6; cx <= 6; cx++) {
+            for (int cz = -6; cz <= 6; cz++) {
+                final LevelChunk chunk = level.getChunkSource().getChunkNow(cx, cz);
+                if (chunk == null) {
+                    h = mix(h, -1);
+                    continue;
+                }
+                for (final LevelChunkSection s : chunk.getSections()) {
+                    if (s.hasOnlyAir()) {
+                        h = mix(h, 0);
+                        continue;
+                    }
+                    for (int y = 0; y < 16; y++) {
+                        for (int z = 0; z < 16; z++) {
+                            for (int x = 0; x < 16; x++) {
+                                h = mix(h, Block.getId(s.getBlockState(x, y, z)));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        return h;
+    }
+
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    private static long[] record(final Bot b, final Packet<?> packet, final int rel, final boolean detail) throws Exception {
+        if (packet instanceof BundlePacket<?> bundle) {
+            long h = 17;
+            int n = 0;
+            for (final Packet<?> sp : (Iterable<Packet<?>>) (Iterable) bundle.subPackets()) {
+                final long[] r = record(b, sp, rel, detail);
+                n += (int) r[0];
+                h = mix(h, r[1]);
+            }
+            return new long[] {n, mix(h, 99)};
+        }
+        if (packet instanceof ClientboundKeepAlivePacket k) {
+            b.pendingAcks.add(new ServerboundKeepAlivePacket(k.getId()));
+            return new long[] {0, 0}; // ids come from the clock
+        }
+        if (packet instanceof ClientboundPlayerPositionPacket pp) {
+            b.awaiting = true;
+            b.pendingAcks.add(new ServerboundAcceptTeleportationPacket(pp.id(), pp.change().position().x, pp.change().position().y, pp.change().position().z, pp.change().yRot(), pp.change().xRot()));
+        }
+        if (packet instanceof ClientboundChunkBatchFinishedPacket) {
+            b.pendingAcks.add(new ServerboundChunkBatchReceivedPacket(25.0F));
+        }
+        final String name = packet.getClass().getSimpleName();
+        if (name.contains("Ping") || name.contains("Pong")) {
+            return new long[] {0, 0};
+        }
+        final var buf = new RegistryFriendlyByteBuf(Unpooled.buffer(), b.player.level().registryAccess());
+        ((ProtocolInfo) info).codec().encode(buf, packet);
+        final byte[] bytes = new byte[buf.readableBytes()];
+        buf.readBytes(bytes);
+        long h = name.hashCode();
+        for (final byte x : bytes) {
+            h = 31 * h + x;
+        }
+        if (detail) {
+            out.write("D " + rel + " " + b.index + " " + name + " " + bytes.length + " " + Long.toHexString(h) + "\n");
+        }
+        return new long[] {1, mix(h, b.index)};
+    }
+}
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index ec78129ab611ef7ee04ea76a459e7d39788429a0..fa38eb6f357f5910e03e4d0994f874133bcfdaeb 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1650,6 +1650,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         // Paper start - Server Tick Events
         long endTime = System.nanoTime();
         long remaining = this.nextTickTimeNanos - endTime;
+        if (net.minecraft.server.LabNet.ON) net.minecraft.server.LabNet.postTick(this);
         if (net.minecraft.server.LabPhase.ON) net.minecraft.server.LabPhase.endTick(this.tickCount, ((double)(endTime - this.currentTickStart) / 1000000D));
         new com.destroystokyo.paper.event.server.ServerTickEndEvent(this.tickCount, ((double)(endTime - this.currentTickStart) / 1000000D), remaining).callEvent();
         // Paper end - Server Tick Events
@@ -1670,6 +1671,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         profiler.push("tick");
         this.tickFrame.start();
         // Paper - improve tick loop - moved into runAllTasksAtTickStart
+        if (net.minecraft.server.LabNet.ON) net.minecraft.server.LabNet.preTick(this);
         final long labT0 = net.minecraft.server.LabPhase.ON ? net.minecraft.server.LabPhase.t() : 0L;
         this.runAllTasksAtTickStart(); // Paper - improve tick loop
         if (net.minecraft.server.LabPhase.ON) net.minecraft.server.LabPhase.add(net.minecraft.server.LabPhase.TASKS, labT0);
