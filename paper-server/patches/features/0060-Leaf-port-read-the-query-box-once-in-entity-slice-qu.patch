+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/ChunkEntitySlices.java
@@ -532,6 +532,15 @@ public final class ChunkEntitySlices {
 
             final BasicEntityList<Entity>[] entitiesBySection = this.entitiesBySection;
 
+            // Leaf port start - read the query box once instead of per entity (Leaf "Optimise getEntities", Taiyou06, Martijn Muijsers; MIT)
+            final double boxMinX = box.minX;
+            final double boxMinY = box.minY;
+            final double boxMinZ = box.minZ;
+            final double boxMaxX = box.maxX;
+            final double boxMaxY = box.maxY;
+            final double boxMaxZ = box.maxZ;
+            // Leaf port end
+
             for (int section = min; section <= max; ++section) {
                 final BasicEntityList<Entity> list = entitiesBySection[section - minSection];
 
@@ -544,9 +553,18 @@ public final class ChunkEntitySlices {
                 for (int i = 0, len = Math.min(storage.length, list.size()); i < len; ++i) {
                     final Entity entity = storage[i];
 
-                    if (entity == null || entity == except || !entity.getBoundingBox().intersects(box)) {
+                    if (entity == null || entity == except) {
+                        continue;
+                    }
+
+                    // Leaf port start - AABB#intersects(AABB) inlined against the cached box, same comparisons (so the same answer for NaN)
+                    final AABB entityBox = entity.getBoundingBox();
+                    if (!(entityBox.minX < boxMaxX && entityBox.maxX > boxMinX
+                        && entityBox.minY < boxMaxY && entityBox.maxY > boxMinY
+                        && entityBox.minZ < boxMaxZ && entityBox.maxZ > boxMinZ)) {
                         continue;
                     }
+                    // Leaf port end
 
                     if (predicate != null && !predicate.test(entity)) {
                         continue;
@@ -572,6 +590,15 @@ public final class ChunkEntitySlices {
 
             final BasicEntityList<Entity>[] entitiesBySection = this.entitiesBySection;
 
+            // Leaf port start - read the query box once instead of per entity (Leaf "Optimise getEntities", Taiyou06, Martijn Muijsers; MIT)
+            final double boxMinX = box.minX;
+            final double boxMinY = box.minY;
+            final double boxMinZ = box.minZ;
+            final double boxMaxX = box.maxX;
+            final double boxMaxY = box.maxY;
+            final double boxMaxZ = box.maxZ;
+            // Leaf port end
+
             for (int section = min; section <= max; ++section) {
                 final BasicEntityList<Entity> list = entitiesBySection[section - minSection];
 
@@ -584,9 +611,18 @@ public final class ChunkEntitySlices {
                 for (int i = 0, len = Math.min(storage.length, list.size()); i < len; ++i) {
                     final Entity entity = storage[i];
 
-                    if (entity == null || entity == except || !entity.getBoundingBox().intersects(box)) {
+                    if (entity == null || entity == except) {
+                        continue;
+                    }
+
+                    // Leaf port start - AABB#intersects(AABB) inlined against the cached box, same comparisons (so the same answer for NaN)
+                    final AABB entityBox = entity.getBoundingBox();
+                    if (!(entityBox.minX < boxMaxX && entityBox.maxX > boxMinX
+                        && entityBox.minY < boxMaxY && entityBox.maxY > boxMinY
+                        && entityBox.minZ < boxMaxZ && entityBox.maxZ > boxMinZ)) {
                         continue;
                     }
+                    // Leaf port end
 
                     if (predicate != null && !predicate.test(entity)) {
                         continue;
