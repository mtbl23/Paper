@@ -217,6 +217,40 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         return this.lookControl;
     }
 
+    // Lab start - AI level of detail (Tier B, off by default), see io.papermc.paper.entity.activation.AiLod
+    public long aiNearTick = -1000L;
+    public long aiRangeTick = -1000L;
+
+    /** Idle and not entangled with anything a player can see or touch; only then may a far mob be throttled. */
+    public boolean aiLodEligible() {
+        return this.target == null
+            && !this.isPassenger()
+            && !this.isVehicle()
+            && !this.isLeashed()
+            && this.hurtTime == 0
+            && this.getLastHurtByMob() == null;
+    }
+
+    /** Brain mobs whose brain may be ticked at the far rate (a whitelist: only mobs whose brain does nothing a player can notice when idle). */
+    public boolean aiLodBrainEligible() {
+        return false;
+    }
+
+    /** True when the brain tick of this mob is skipped this tick (far, idle, not its turn). Called from Brain#tick. */
+    public final boolean aiLodSkipBrain() {
+        final io.papermc.paper.configuration.WorldConfiguration.Entities.Behavior.AiLod cfg = io.papermc.paper.entity.activation.AiLod.config(this.level());
+        return cfg.enabled
+            && io.papermc.paper.entity.activation.AiLod.skipTick(this, cfg.brainRate)
+            && this.aiLodBrainEligible()
+            && this.aiLodFar(cfg);
+    }
+
+    /** True when this mob's selectors/brain run at the far rate this tick. Only called with the feature enabled. */
+    public final boolean aiLodFar(final io.papermc.paper.configuration.WorldConfiguration.Entities.Behavior.AiLod cfg) {
+        return io.papermc.paper.entity.activation.AiLod.isFar(this, cfg);
+    }
+    // Lab end
+
