diff --git a/io/papermc/paper/entity/activation/AiLod.java b/io/papermc/paper/entity/activation/AiLod.java
new file mode 100644
index 0000000000000000000000000000000000000000..d3a96a34726ab16cae57dbfe291557ed63f5edbe
--- /dev/null
+++ b/io/papermc/paper/entity/activation/AiLod.java
@@ -0,0 +1,59 @@
+package io.papermc.paper.entity.activation;
+
+import io.papermc.paper.configuration.WorldConfiguration;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.level.Level;
+
+/**
+ * Lab (sub-ai, Tier B): AI level of detail. Off by default (paper-world config entities.behavior.ai-lod.enabled).
+ * <p>
+ * A mob is "in range" when it is inside the activation query box of a non-spectator player at the start of the entity phase and
+ * "near" when it is also within near-distance (box distance on every axis) of one (both marked by
+ * {@link ActivationRange#activateEntities}). Mobs outside every query box stay under Paper's own activation range logic.
+ * An in-range, not near and idle mob (see {@link Mob#aiLodEligible()}) runs the expensive part of its AI at a reduced rate: the
+ * goal and target selector update (which vanilla runs every second tick) and, for the whitelisted brain mobs, the brain tick.
+ * Running goals that need updating every tick, navigation, controls and everything else still run every tick. A near mob (or a
+ * mob that stops being idle) is back at the vanilla rate on the very next tick.
+ */
+public final class AiLod {
+    /** Ticks a mob stays "near" after the last player left the near box (avoids flapping at the boundary). */
+    private static final int NEAR_HYSTERESIS = 10;
+    /** New mobs always run at the vanilla rate for this long. */
+    private static final int WARMUP_TICKS = 100;
+
+    private AiLod() {
+    }
+
+    /** Called from {@link ActivationRange#activateEntities} for every entity in range of a player. */
+    static void markNear(final Entity entity, final Player player, final int near) {
+        if (!(entity instanceof final Mob mob)) {
+            return;
+        }
+        mob.aiRangeTick = MinecraftServer.currentTick; // in the query box of a player: Paper's activation range logic governs it, LOD only refines inside
+        if (Math.abs(entity.getX() - player.getX()) <= near
+            && Math.abs(entity.getZ() - player.getZ()) <= near
+            && Math.abs(entity.getY() - player.getY()) <= near) {
+            mob.aiNearTick = MinecraftServer.currentTick;
+        }
+    }
+
+    /** True when the mob must tick its selectors / brain at the reduced far rate (config enabled, far from players, idle). */
+    public static boolean isFar(final Mob mob, final WorldConfiguration.Entities.Behavior.AiLod cfg) {
+        return mob.aiRangeTick == MinecraftServer.currentTick
+            && MinecraftServer.currentTick - mob.aiNearTick > NEAR_HYSTERESIS
+            && mob.tickCount > WARMUP_TICKS
+            && mob.aiLodEligible();
+    }
+
+    /** True when this is not the mob's turn at the given far rate (staggered by entity id so the load is even). */
+    public static boolean skipTick(final Mob mob, final int rate) {
+        return rate > 1 && (mob.tickCount + mob.getId()) % rate != 0;
+    }
+
+    public static WorldConfiguration.Entities.Behavior.AiLod config(final Level level) {
+        return level.paperConfig().entities.behavior.aiLod;
+    }
+}
diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index 0e928f7c38e7cf32bcc7412ac413b3ebdc9674c9..1e58ef2e75546fb74df74f961cfe399d8f1821b1 100644
