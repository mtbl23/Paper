+        // Lab start - AI level of detail: a far idle mob runs the full selector updates less often than every 2 ticks (rate 2 is vanilla)
+        int targetRate = 2;
+        int goalRate = 2;
+        final io.papermc.paper.configuration.WorldConfiguration.Entities.Behavior.AiLod aiLod = io.papermc.paper.entity.activation.AiLod.config(this.level());
+        if (aiLod.enabled && this.aiLodFar(aiLod)) {
+            targetRate = Math.max(2, aiLod.targetSelectorRate);
+            goalRate = Math.max(2, aiLod.goalSelectorRate);
+        }
+        final boolean fullTargetTick = idBasedTickCount % targetRate == 0 || this.tickCount <= 1;
+        final boolean fullGoalTick = idBasedTickCount % goalRate == 0 || this.tickCount <= 1;
+        profiler.push("targetSelector");
+        if (fullTargetTick) {
             this.targetSelector.tick();
-            profiler.pop();
-            profiler.push("goalSelector");
+        } else {
+            this.targetSelector.tickRunningGoals(false);
+        }
+        profiler.pop();
+        profiler.push("goalSelector");
+        if (fullGoalTick) {
             this.goalSelector.tick();
-            profiler.pop();
+        } else {
+            this.goalSelector.tickRunningGoals(false);
         }
+        profiler.pop();
