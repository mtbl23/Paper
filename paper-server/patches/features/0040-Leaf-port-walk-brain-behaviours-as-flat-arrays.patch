     private void tickEachRunningBehavior(final ServerLevel level, final E body) {
         long timestamp = level.getGameTime();
 
-        for (BehaviorControl<? super E> behavior : this.getRunningBehaviors()) {
-            behavior.tickOrStop(level, body, timestamp);
+        // Leaf port start - snapshot the running behaviours like getRunningBehaviors did, but allocate nothing when none is running
+        List<BehaviorControl<? super E>> running = null;
+        for (BehaviorGroup<E> group : this.behaviorGroups()) {
+            for (BehaviorControl<? super E> behavior : group.behaviors) {
+                if (behavior.getStatus() == Behavior.Status.RUNNING) {
