+    // Leaf port start - Adapted from Leaf "Replace brain with optimized collection" (HaHaWTH, Taiyou06, hayanesuru): the behaviours are
+    // walked as plain arrays instead of through the nested TreeMap/HashMap/LinkedHashSet iterators on every tick. The order is the
+    // iteration order of the original maps (priority ascending, then the activity map order, then insertion order), so behaviour is unchanged.
+    private BehaviorGroup<E>[] behaviorGroups() {
+        BehaviorGroup<E>[] groups = this.behaviorGroups;
+        if (groups == null) {
+            ObjectArrayList<BehaviorGroup<E>> list = new ObjectArrayList<>();
+            for (Map<Activity, Set<BehaviorControl<? super E>>> behavioursByActivities : this.availableBehaviorsByPriority.values()) {
+                for (Entry<Activity, Set<BehaviorControl<? super E>>> behavioursForActivity : behavioursByActivities.entrySet()) {
+                    list.add(new BehaviorGroup<>(behavioursForActivity.getKey(), behavioursForActivity.getValue().toArray(new BehaviorControl[0])));
+                }
+            }
+
+            groups = list.toArray(new BehaviorGroup[0]);
+            this.behaviorGroups = groups;
+        }
+
+        return groups;
+    }
+
+    private record BehaviorGroup<E extends LivingEntity>(Activity activity, BehaviorControl<? super E>[] behaviors) {
+    }
+    // Leaf port end
+
     public void useDefaultActivity() {
         this.setActiveActivity(this.defaultActivity);
     }
