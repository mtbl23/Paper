 public class OrderedBlockMatcher extends BlockMatcher {
     private Iterable<BlockPos> positions;
 
+    // entity deep: the block box behind a Manhattan ordered scan, set by LevelReader#findBlocksInBoxByManhattanDistance (null for any other position source)
+    private int boxMinX;
+    private int boxMinY;
+    private int boxMinZ;
+    private int boxMaxX;
+    private int boxMaxY;
+    private int boxMaxZ;
+    private boolean hasBox;
+
     public OrderedBlockMatcher(final LevelReader level, final Iterable<BlockPos> positions) {
         super(level);
         this.positions = positions;
     }
 
+    /** The positions are exactly the box origin +- (reachX, reachY, reachZ) (the Manhattan depth limit is the sum of the reaches, so nothing is cut off). */
+    public OrderedBlockMatcher withBox(final BlockPos origin, final int reachX, final int reachY, final int reachZ) {
+        this.boxMinX = origin.getX() - reachX;
+        this.boxMinY = origin.getY() - reachY;
+        this.boxMinZ = origin.getZ() - reachZ;
+        this.boxMaxX = origin.getX() + reachX;
+        this.boxMaxY = origin.getY() + reachY;
+        this.boxMaxZ = origin.getZ() + reachZ;
+        this.hasBox = true;
+        return this;
+    }
+
+    /**
+     * True when no block of the scan can pass the state filter: every section overlapping the box is in a loaded chunk and none of their palettes holds a
+     * state that passes. The full scan then finds nothing either (its section cache rejects the same sections), without walking the positions.
+     * Any doubt (not a server level, chunk not loaded, box outside the build height) returns false and the normal scan runs.
+     */
+    private boolean cannotMatch(final Predicate<BlockState> predicate) {
+        if (!this.hasBox || !(this.level instanceof net.minecraft.server.level.ServerLevel serverLevel)) {
+            return false;
+        }
+
+        if (this.boxMinY < serverLevel.getMinY() || this.boxMaxY > serverLevel.getMaxY()) {
+            return false;
+        }
+
+        final int minSectionX = this.boxMinX >> 4;
+        final int maxSectionX = this.boxMaxX >> 4;
+        final int minSectionZ = this.boxMinZ >> 4;
+        final int maxSectionZ = this.boxMaxZ >> 4;
+        final int minSectionY = this.boxMinY >> 4;
+        final int maxSectionY = this.boxMaxY >> 4;
+        for (int x = minSectionX; x <= maxSectionX; x++) {
+            for (int z = minSectionZ; z <= maxSectionZ; z++) {
+                final net.minecraft.world.level.chunk.LevelChunk chunk = serverLevel.getChunkSource().getChunkAtIfLoadedImmediately(x, z);
+                if (chunk == null) {
+                    return false;
+                }
+
+                for (int y = minSectionY; y <= maxSectionY; y++) {
+                    if (chunk.getSection(chunk.getSectionIndexFromSectionY(y)).maybeHas(predicate)) {
+                        return false;
+                    }
+                }
+            }
+        }
+
+        return true;
+    }
+
     public OrderedBlockMatcher filterPos(final Predicate<? super BlockPos> predicate) {
         this.positions = Iterables.filter(this.positions, predicate::test);
         return this;
