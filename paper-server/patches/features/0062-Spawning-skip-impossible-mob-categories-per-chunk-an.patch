@@ -53,6 +53,28 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
             ? (EnvironmentAttributeSystem.ValueSampler<MobSpawnSettings>)spawnSampler : null; // Spawn rework
     }
 
+    private final it.unimi.dsi.fastutil.objects.Reference2IntOpenHashMap<Biome> naturalSpawnCategoryMasks = new it.unimi.dsi.fastutil.objects.Reference2IntOpenHashMap<>();
+
+    // Spawn rework: bit mask (by MobCategory ordinal) of the categories that have a non-empty natural spawn list in the biome (all bits when unknown). Main thread only.
+    public int getNaturalSpawnCategoryMask(final Holder<Biome> biome) {
+        final Biome key = biome.value();
+        final int cached = this.naturalSpawnCategoryMasks.getOrDefault(key, -1);
+        if (cached != -1) {
+            return cached;
+        }
+
+        final MobSpawnSettings settings = this.getNaturalMobSpawnsOfBiome(biome);
+        int mask = 0;
+        for (final net.minecraft.world.entity.MobCategory category : net.minecraft.world.entity.MobCategory.values()) {
+            if (settings == null || !settings.getMobsToSpawn(category).isEmpty()) {
+                mask |= 1 << category.ordinal();
+            }
+        }
+
+        this.naturalSpawnCategoryMasks.put(key, mask);
+        return mask;
+    }
+
     // Spawn rework: what getValue(NATURAL_MOB_SPAWNS, pos) returns when the full resolution biome at pos is the given one (null = not a plain biome layer, use getValue).
     public @Nullable MobSpawnSettings getNaturalMobSpawnsOfBiome(final Holder<Biome> biome) {
         final EnvironmentAttributeSystem.ValueSampler<MobSpawnSettings> sampler = this.naturalMobSpawnsBiomeSampler;
