+        // Spawn rework: every spawn-state-reuse-ticks ticks the mobs are counted, the ticks in between use that count plus the spawns since (per player mob spawns only)
+        final int reuseTicks = this.level.paperConfig().entities.spawning.spawnStateReuseTicks;
+        final boolean reuseSpawnState = reuseTicks > 1 && this.lastSpawnState != null && this.level.paperConfig().entities.spawning.perPlayerMobSpawns
+            && (this.spawnFriendlies || this.spawnEnemies) && this.level.getGameTime() % reuseTicks != 0L;
         if ((this.spawnFriendlies || this.spawnEnemies) && this.level.paperConfig().entities.spawning.perPlayerMobSpawns) { // don't count mobs when animals and monsters are disabled
             // re-set mob counts
             for (ServerPlayer player : this.level.players()) {
                 // Paper start - per player mob spawning backoff
                 for (int j = 0; j < ServerPlayer.MOBCATEGORY_TOTAL_ENUMS; j++) {
-                    player.mobCounts[j] = 0;
+                    if (!reuseSpawnState) {
+                        player.mobCounts[j] = 0;
+                    }
 
                     int newBackoff = player.mobBackoffCounts[j] - 1; // TODO make configurable bleed // TODO use nonlinear algorithm?
                     if (newBackoff < 0) {
@@ -564,7 +570,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
                 }
                 // Paper end - per player mob spawning backoff
             }
-            spawnCookie = NaturalSpawner.createState(chunkCount, this.level, this.fullChunkGetter, null, true);
+            spawnCookie = reuseSpawnState ? this.lastSpawnState.reuse(chunkCount) : NaturalSpawner.createState(chunkCount, this.level, this.fullChunkGetter, null, true);
         } else {
             spawnCookie = NaturalSpawner.createState(chunkCount, this.level, this.fullChunkGetter, !this.level.paperConfig().entities.spawning.perPlayerMobSpawns ? new LocalMobCapCalculator(this.chunkMap) : null, false);
         }
diff --git a/net/minecraft/world/attribute/EnvironmentAttributeSystem.java b/net/minecraft/world/attribute/EnvironmentAttributeSystem.java
