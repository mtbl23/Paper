diff --git a/net/minecraft/world/level/SpawnableCategories.java b/net/minecraft/world/level/SpawnableCategories.java
new file mode 100644
index 0000000000000000000000000000000000000000..2c06fcbc85740da318f0804c71bc0ee8ddf0a286
--- /dev/null
+++ b/net/minecraft/world/level/SpawnableCategories.java
@@ -0,0 +1,125 @@
+package net.minecraft.world.level;
+
+import it.unimi.dsi.fastutil.longs.LongSet;
+import java.util.Map;
+import net.minecraft.core.Holder;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.tags.FluidTags;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.entity.SpawnPlacementTypes;
+import net.minecraft.world.entity.SpawnPlacements;
+import net.minecraft.world.level.biome.Biome;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.levelgen.structure.Structure;
+
+/**
+ * Spawn rework (config entities.spawning.skip-impossible-categories, off by default): which mob categories a natural spawn attempt
+ * from a chunk can possibly succeed in. A category that cannot succeed anywhere around the chunk is skipped for that chunk, which
+ * saves its random position, block read and biome lookups. The attempts that are skipped could not have spawned anything, so the
+ * spawn rate is unchanged; only the random numbers other systems see differ.
+ *
+ * <p>A category is possible for a chunk when some chunk in the 3x3 neighbourhood has a biome with a non-empty spawn list for it or
+ * a structure reference with a spawn override for it. A category that only spawns in water is possible only when some chunk in the
+ * neighbourhood has water in its block palettes. The data is cached on the chunks and refreshed every {@link #REFRESH_TICKS} ticks
+ * (biomes and structure references only change through plugins or generation, water through players and the world).
+ */
+public final class SpawnableCategories {
+    public static final int ALL = (1 << MobCategory.values().length) - 1;
+    public static final int REFRESH_TICKS = 200;
+    private static final int OWN_WATER_FLAG = 1 << 30;
+    private static final int UNLOADED_NEIGHBOUR_RETRY_TICKS = 20;
+    private static int waterOnlyCategories = -1;
+
+    private SpawnableCategories() {
+    }
+
+    // Categories whose every entity type needs water at the spawn position (derived from the spawn placements, not assumed)
+    private static int waterOnlyCategories() {
+        int mask = waterOnlyCategories;
+        if (mask == -1) {
+            mask = ALL;
+            for (final EntityType<?> type : BuiltInRegistries.ENTITY_TYPE) {
+                if (SpawnPlacements.getPlacementType(type) != SpawnPlacementTypes.IN_WATER) {
+                    mask &= ~(1 << type.getCategory().ordinal());
+                }
+            }
+            mask &= ~(1 << MobCategory.MISC.ordinal());
+            waterOnlyCategories = mask;
+        }
+
+        return mask;
+    }
+
+    /** Bit mask (by MobCategory ordinal) of the categories a spawn attempt from this chunk can succeed in. */
+    public static int get(final ServerLevel level, final LevelChunk chunk) {
+        final long now = level.getGameTime();
+        if (now < chunk.spawnableCategoryMaskExpiry) {
+            return chunk.spawnableCategoryMask;
+        }
+
+        return refresh(level, chunk, now);
+    }
+
+    private static int refresh(final ServerLevel level, final LevelChunk chunk, final long now) {
+        final int chunkX = chunk.getPos().x();
+        final int chunkZ = chunk.getPos().z();
+        int mask = 0;
+        boolean water = false;
+        boolean complete = true;
+        for (int dx = -1; dx <= 1; dx++) {
+            for (int dz = -1; dz <= 1; dz++) {
+                final LevelChunk neighbour = dx == 0 && dz == 0 ? chunk : level.getChunkSource().getChunkAtIfLoadedImmediately(chunkX + dx, chunkZ + dz);
+                if (neighbour == null) {
+                    complete = false;
+                    continue;
+                }
+
+                final int own = own(level, neighbour, now);
+                mask |= own & ALL;
+                water |= (own & OWN_WATER_FLAG) != 0;
+            }
+        }
+
+        if (!complete) {
+            mask = ALL; // an unloaded neighbour is unknown: allow everything and look again soon
+        } else if (!water) {
+            mask &= ~waterOnlyCategories();
+        }
+
+        chunk.spawnableCategoryMask = mask;
+        // staggered by chunk so that chunks loaded together do not all refresh in the same tick
+        chunk.spawnableCategoryMaskExpiry = now + (complete ? REFRESH_TICKS + Math.floorMod(chunk.getPos().longKey() * 0x9E3779B97F4A7C15L >>> 40, REFRESH_TICKS / 2) : UNLOADED_NEIGHBOUR_RETRY_TICKS);
+        return mask;
+    }
+
+    // Categories with a biome spawn list or structure spawn override in this chunk, plus OWN_WATER_FLAG when its block palettes may hold water
+    private static int own(final ServerLevel level, final LevelChunk chunk, final long now) {
+        if (now < chunk.ownSpawnableCategoryMaskExpiry) {
+            return chunk.ownSpawnableCategoryMask;
+        }
+
+        final int[] mask = {0};
+        boolean water = false;
+        final net.minecraft.world.attribute.EnvironmentAttributeSystem attributes = level.environmentAttributes();
+        for (final LevelChunkSection section : chunk.getSections()) {
+            section.getBiomes().forEachPaletteValue(biome -> mask[0] |= attributes.getNaturalSpawnCategoryMask(biome));
+            if (!water && !section.hasOnlyAir()) {
+                water = section.getStates().maybeHas(state -> !state.getFluidState().isEmpty() && state.getFluidState().is(FluidTags.WATER));
+            }
+        }
+
+        for (final Map.Entry<Structure, LongSet> reference : chunk.getAllReferences().entrySet()) {
+            for (final MobCategory category : reference.getKey().spawnOverrides().keySet()) {
+                mask[0] |= 1 << category.ordinal();
+            }
+        }
+
+        final int own = mask[0] | (water ? OWN_WATER_FLAG : 0);
+        chunk.ownSpawnableCategoryMask = own;
+        chunk.ownSpawnableCategoryMaskExpiry = now + REFRESH_TICKS / 2;
+        return own;
+    }
+}
