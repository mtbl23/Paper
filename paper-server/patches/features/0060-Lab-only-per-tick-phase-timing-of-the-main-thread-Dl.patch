From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mtbl23 <mbhangal23@gmail.com>
Date: Thu, 12 Nov 2026 23:50:26 -0500
Subject: [PATCH] Lab only: per-tick phase timing of the main thread
 (-Dlab.phases)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/net/minecraft/server/LabPhase.java b/net/minecraft/server/LabPhase.java
new file mode 100644
index 0000000000000000000000000000000000000000..5478388b8d8741c53c850f4fee77d090f1ff499d
--- /dev/null
+++ b/net/minecraft/server/LabPhase.java
@@ -0,0 +1,57 @@
+package net.minecraft.server;
+
+import java.io.BufferedWriter;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/**
+ * Lab only: per-tick phase timing of the main thread. Enabled with -Dlab.phases=&lt;csv path&gt;; when the property is absent
+ * every call is a constant-false branch. All calls come from the main thread. Phases nest (see the names), values are inclusive.
+ */
+public final class LabPhase {
+    public static final boolean ON = System.getProperty("lab.phases") != null;
+    public static final int TASKS = 0, PRE = 1, LEVELS = 2, BLOCKTICKS = 3, CHUNKSRC = 4, PURGE = 5, PLAYERLOADER = 6, TICKCHUNKS = 7,
+        SPAWNCOUNT = 8, SPAWNCHUNKS = 9, RANDOMTICK = 10, CUSTOMSPAWN = 11, BROADCAST = 12, TRACKER = 13, UNLOAD = 14, BLOCKEVENTS = 15,
+        ENTITIES = 16, BLOCKENT = 17, CONNECTION = 18, PLAYERS = 19, SENDCHUNKS = 20, SAVE = 21, MIDTICK = 22, SPAWNFOR = 23, SENDCHANGES = 24, TICKTHUNDER = 25, N = 26;
+    private static final String[] NAMES = {"tasks", "pre", "levels", "blockticks", "chunksrc", "purge", "playerloader", "tickchunks",
+        "spawncount", "spawnchunks", "randomtick", "customspawn", "broadcast", "tracker", "unload", "blockevents",
+        "entities", "blockent", "connection", "players", "sendchunks", "save", "midtick", "spawnfor", "sendchanges", "thunder"};
+    private static final long[] ACC = new long[N];
+    private static BufferedWriter out;
+
+    private LabPhase() {}
+
+    public static long t() {
+        return System.nanoTime();
+    }
+
+    public static void add(final int phase, final long t0) {
+        ACC[phase] += System.nanoTime() - t0;
+    }
+
+    /** Called once per tick just before the tick end event. */
+    public static void endTick(final int tick, final double durationMs) {
+        try {
+            if (out == null) {
+                out = Files.newBufferedWriter(Path.of(System.getProperty("lab.phases")));
+                out.write("epoch_ms,tick,duration_ms");
+                for (final String n : NAMES) {
+                    out.write("," + n);
+                }
+                out.write('\n');
+            }
+            final StringBuilder sb = new StringBuilder(256);
+            sb.append(System.currentTimeMillis()).append(',').append(tick).append(',').append(String.format("%.3f", durationMs));
+            for (int i = 0; i < N; i++) {
+                sb.append(',').append(String.format("%.3f", ACC[i] / 1.0E6));
+                ACC[i] = 0L;
+            }
+            out.write(sb.append('\n').toString());
+            if ((tick & 63) == 0) {
+                out.flush();
+            }
+        } catch (final java.io.IOException e) {
+            throw new RuntimeException(e);
+        }
+    }
+}
