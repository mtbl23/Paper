From: mtbl23 <182822903+mtbl23@users.noreply.github.com>
Date: Tue, 10 Nov 2026 17:17:05 -0500
Subject: [PATCH] Only remove block entity tickers when one was removed

tickBlockEntities always ran removeAll over the whole ticker list, even when the set to remove held only null. The set
is now built lazily; null cannot be in the list (the loop would already have thrown on it), so behaviour is unchanged.

diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index b8639ed99cda45ef6e501e8ace927e4291ccadf8..2271a83364e8491508e055afd870cbb3389d74f7 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1503,12 +1503,17 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
 
         int tickedEntities = 0; // Paper - rewrite chunk system
         // Paper start - Fix MC-117075 use removeAll
-        final it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<@Nullable TickingBlockEntity> toRemove = new it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<>();
-        toRemove.add(null);
+        // Only built when a ticker was removed: an empty removeAll still walked the whole ticker list (and null cannot be in it,
+        // the loop below would have thrown on it)
+        it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<@Nullable TickingBlockEntity> toRemove = null;
         for (int tickerIndex = 0; tickerIndex < this.blockEntityTickers.size(); tickerIndex++) {
             final TickingBlockEntity ticker = this.blockEntityTickers.get(tickerIndex);
         // Paper end - Fix MC-117075 use removeAll
             if (ticker.isRemoved()) {
+                if (toRemove == null) {
+                    toRemove = new it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<>();
+                    toRemove.add(null);
+                }
                 toRemove.add(ticker); // Paper - Fix MC-117075 use removeAll
             } else if (tickBlockEntities && this.shouldTickBlockEntityAt(ticker.getPos())) { // Lithium - a sleeping block entity ticker has no position and does nothing
                 ticker.tick();
@@ -1520,7 +1525,9 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
             }
         }
 
-        this.blockEntityTickers.removeAll(toRemove); // Paper - Fix MC-117075 use removeAll
+        if (toRemove != null) {
+            this.blockEntityTickers.removeAll(toRemove); // Paper - Fix MC-117075 use removeAll
+        }
         this.tickingBlockEntities = false;
     }
 
