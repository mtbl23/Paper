+    /** Order independent hash of every attribute: key, base value, current value and every modifier (id, amount, operation). */
+    private static long attributeHash(final LivingEntity le) {
+        long total = 0;
+        for (final net.minecraft.world.entity.ai.attributes.AttributeInstance a : le.getAttributes().getSyncableAttributes()) {
+            long h = a.getAttribute().getRegisteredName().hashCode();
+            h = mix(h, Double.doubleToLongBits(a.getBaseValue()));
+            h = mix(h, Double.doubleToLongBits(a.getValue()));
+            long m = 0;
+            for (final net.minecraft.world.entity.ai.attributes.AttributeModifier mod : a.getModifiers()) {
+                m += mix(mix(mod.id().toString().hashCode(), Double.doubleToLongBits(mod.amount())), mod.operation().ordinal());
+            }
+            total += mix(h, m);
+        }
+        return total;
+    }
+
+    private static String attrText(final net.minecraft.network.protocol.game.ClientboundUpdateAttributesPacket u) {
+        final StringBuilder sb = new StringBuilder();
+        for (final var s : u.getValues()) {
+            sb.append(s.attribute().getRegisteredName()).append('=').append(s.base());
+            for (final var mod : s.modifiers()) {
+                sb.append('{').append(mod.id()).append(':').append(mod.amount()).append(':').append(mod.operation()).append('}');
+            }
+            sb.append(';');
+        }
+        return sb.toString();
+    }
+
