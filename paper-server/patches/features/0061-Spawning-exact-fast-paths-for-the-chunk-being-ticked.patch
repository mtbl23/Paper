-        return isInNetherFortressBounds(pos, level, mobCategory, structureManager)
-            ? NetherFortressStructure.FORTRESS_ENEMIES
-            : generator.getMobsAt(level, structureManager, mobCategory, pos);
+        // Spawn rework: posChunk (the loaded chunk containing pos, or null) answers the block below, the structure references and the biome without chunk lookups
+        if (posChunk == null || generator instanceof org.bukkit.craftbukkit.generator.CustomChunkGenerator) {
+            return isInNetherFortressBounds(pos, level, mobCategory, structureManager)
+                ? NetherFortressStructure.FORTRESS_ENEMIES
+                : generator.getMobsAt(level, structureManager, mobCategory, pos);
+        }
+
+        if (mobCategory == MobCategory.MONSTER && posChunk.getBlockState(pos.below()).is(Blocks.NETHER_BRICKS)) {
+            Structure fortress = structureManager.registryAccess().lookupOrThrow(Registries.STRUCTURE).getValue(BuiltinStructures.FORTRESS);
+            if (fortress != null && structureManager.getStructureAt(pos, fortress).isValid()) {
+                return NetherFortressStructure.FORTRESS_ENEMIES;
+            }
+        }
+
+        return generator.getMobsAt(level, structureManager, mobCategory, pos, posChunk.getAllReferences(), singleBiomeAt(posChunk, pos));
+    }
+
+    // The biome that the full resolution lookup returns at pos when it cannot be anything else: pos is at least 2 blocks from every section face
+    // (all 8 corner cells of the fiddled lookup lie inside the section) and the section has a single biome. Null otherwise.
+    private static @Nullable Holder<Biome> singleBiomeAt(final LevelChunk chunk, final BlockPos pos) {
+        final int localX = pos.getX() & 15;
+        final int localY = pos.getY() & 15;
+        final int localZ = pos.getZ() & 15;
+        if (localX < 2 || localX > 13 || localY < 2 || localY > 13 || localZ < 2 || localZ > 13) {
+            return null;
+        }
+
+        final int sectionIndex = chunk.getSectionIndex(pos.getY());
+        final LevelChunkSection[] sections = chunk.getSections();
+        if (sectionIndex < 0 || sectionIndex >= sections.length) {
+            return null;
+        }
+
+        return sections[sectionIndex].getBiomes().getSingleValueOrNull();
     }
 
