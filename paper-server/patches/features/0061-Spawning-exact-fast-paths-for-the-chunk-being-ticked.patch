     // Leaf port end
+    // Spawn rework: set when NATURAL_MOB_SPAWNS is exactly the constant base value plus the one positional biome layer, so the value is a pure function of the biome
+    private final EnvironmentAttributeSystem.@Nullable ValueSampler<MobSpawnSettings> naturalMobSpawnsBiomeSampler;
 
     private EnvironmentAttributeSystem(
         final Map<EnvironmentAttribute<?>, List<EnvironmentAttributeLayer<?>>> layersByAttribute, final @Nullable Set<EntityType<?>> biomeSpawnCostTypes
@@ -46,6 +48,19 @@ public class EnvironmentAttributeSystem implements EnvironmentAttributeReader {
                 )
         );
         this.naturalMobSpawnCostTypes = this.computeNaturalMobSpawnCostTypes(biomeSpawnCostTypes); // Leaf port
+        final EnvironmentAttributeSystem.ValueSampler<?> spawnSampler = this.attributeSamplers.get(EnvironmentAttributes.NATURAL_MOB_SPAWNS);
+        this.naturalMobSpawnsBiomeSampler = spawnSampler != null && spawnSampler.layers.size() == 1 && spawnSampler.layers.getFirst() instanceof EnvironmentAttributeLayer.Positional
+            ? (EnvironmentAttributeSystem.ValueSampler<MobSpawnSettings>)spawnSampler : null; // Spawn rework
+    }
+
+    // Spawn rework: what getValue(NATURAL_MOB_SPAWNS, pos) returns when the full resolution biome at pos is the given one (null = not a plain biome layer, use getValue).
+    public @Nullable MobSpawnSettings getNaturalMobSpawnsOfBiome(final Holder<Biome> biome) {
+        final EnvironmentAttributeSystem.ValueSampler<MobSpawnSettings> sampler = this.naturalMobSpawnsBiomeSampler;
+        if (sampler == null) {
+            return null;
+        }
+
+        return sampler.attribute.sanitizeValue(biome.value().getAttributes().applyModifier(sampler.attribute, sampler.baseValue));
     }
 
