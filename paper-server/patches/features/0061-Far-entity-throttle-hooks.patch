+    // Lab - far entity throttle: ages in real time on the ticks that skip the full tick (never reached without the throttle, orbs are always active)
+    @Override
+    public void inactiveTick() {
+        super.inactiveTick();
+        this.age++;
+        if (this.age >= 6000) {
+            this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN);
+        }
+    }
