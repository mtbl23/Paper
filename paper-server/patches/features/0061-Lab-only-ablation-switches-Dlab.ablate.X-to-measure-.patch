From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mtbl23 <mbhangal23@gmail.com>
Date: Fri, 13 Nov 2026 10:18:11 -0500
Subject: [PATCH] Lab only: ablation switches (-Dlab.ablate.X) to measure the
 ceiling of behaviour-loosening levers


diff --git a/net/minecraft/server/LabAblate.java b/net/minecraft/server/LabAblate.java
new file mode 100644
index 0000000000000000000000000000000000000000..0592775865bc1fcd08d70025f1da3651ff3e9867
--- /dev/null
+++ b/net/minecraft/server/LabAblate.java
@@ -0,0 +1,99 @@
+package net.minecraft.server;
+
+import it.unimi.dsi.fastutil.longs.Long2BooleanOpenHashMap;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+
+/**
+ * Lab only, ablation study: crude switches that completely skip a candidate piece of non-player simulation, to measure how many
+ * ms/tick each would free if it were free. All off by default. Each lever is a system property lab.ablate.&lt;name&gt;:
+ * "true" skips the work only where no player is within a radius (32 blocks, 48 for items; override with lab.ablate.radius),
+ * "all" skips it everywhere. Distances are horizontal and measured to the nearest point of the chunk the work belongs to, in the
+ * same dimension, cached per chunk per tick. Never part of a shipped build: this changes behaviour on purpose.
+ */
+public final class LabAblate {
+    public static final int SPAWN = 0, TRACKER = 1, AI = 2, ITEMS = 3, RANDOM = 4, COLLIDE = 5, BLOCKENT = 6, N = 7;
+    private static final String[] NAMES = {"spawn", "tracker", "ai", "items", "random", "collide", "blockent"};
+    public static final boolean[] ON = new boolean[N];
+    private static final boolean[] ALL = new boolean[N];
+    private static final long[] RADIUS_SQ = new long[N];
+
+    static {
+        final int override = Integer.getInteger("lab.ablate.radius", -1);
+        for (int i = 0; i < N; i++) {
+            final String v = System.getProperty("lab.ablate." + NAMES[i]);
+            ON[i] = v != null && !v.equals("false");
+            ALL[i] = "all".equals(v);
+            final long r = override >= 0 ? override : (i == ITEMS ? 48 : 32);
+            RADIUS_SQ[i] = r * r;
+        }
+    }
+
+    /** Per-level cache: chunk key -> a player is within the lever's radius, valid for one server tick per lever. */
+    public static final class Cache {
+        private final Long2BooleanOpenHashMap[] near = new Long2BooleanOpenHashMap[N];
+        private final int[] stamp = new int[N];
+
+        public Cache() {
+            for (int i = 0; i < N; i++) {
+                this.near[i] = new Long2BooleanOpenHashMap();
+                this.stamp[i] = -1;
+            }
+        }
+    }
+
+    private LabAblate() {}
+
+    /** True when the lever's work for a thing in chunk (cx, cz) of this level should be skipped. */
+    public static boolean skipChunk(final int lever, final ServerLevel level, final int cx, final int cz) {
+        if (ALL[lever]) {
+            return true;
+        }
+        final Cache c = level.labAblate;
+        final int now = level.getServer().getTickCount();
+        final Long2BooleanOpenHashMap map = c.near[lever];
+        if (c.stamp[lever] != now) {
+            map.clear();
+            c.stamp[lever] = now;
+        }
+        final long key = (cx & 0xFFFFFFFFL) | ((long)cz << 32);
+        if (map.containsKey(key)) {
+            return !map.get(key);
+        }
+        final long minX = (long)cx << 4, maxX = minX + 15, minZ = (long)cz << 4, maxZ = minZ + 15;
+        boolean near = false;
+        for (final ServerPlayer player : level.players()) {
+            final double px = player.getX(), pz = player.getZ();
+            final double dx = Math.max(Math.max(minX - px, px - maxX), 0.0);
+            final double dz = Math.max(Math.max(minZ - pz, pz - maxZ), 0.0);
+            if (dx * dx + dz * dz <= RADIUS_SQ[lever]) {
+                near = true;
+                break;
+            }
+        }
+        map.put(key, near);
+        return !near;
+    }
+
+    public static boolean skipEntity(final int lever, final Entity entity) {
+        if (ALL[lever]) {
+            return true;
+        }
+        return entity.level() instanceof ServerLevel level && skipChunk(lever, level, net.minecraft.util.Mth.floor(entity.getX()) >> 4, net.minecraft.util.Mth.floor(entity.getZ()) >> 4);
+    }
+
+    public static boolean skipBlock(final int lever, final ServerLevel level, final net.minecraft.core.BlockPos pos) {
+        return ALL[lever] || skipChunk(lever, level, pos.getX() >> 4, pos.getZ() >> 4);
+    }
+
+    public static boolean isAll(final int lever) {
+        return ALL[lever];
+    }
+
+    /** Item entities, experience orbs, villagers and animals (lever ITEMS). */
+    public static boolean isItemLike(final Entity entity) {
+        return entity instanceof net.minecraft.world.entity.item.ItemEntity || entity instanceof net.minecraft.world.entity.ExperienceOrb
+            || entity instanceof net.minecraft.world.entity.npc.villager.Villager || entity instanceof net.minecraft.world.entity.animal.Animal;
+    }
+}
